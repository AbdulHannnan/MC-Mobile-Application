# .env.example — TEMPLATE of the environment variables this app expects.
#
# This file IS committed to git and contains NO secrets — it documents which
# variables exist and their shape. To run the app locally, copy it to `.env`
# and fill in real values:
#
#     cp .env.example .env      (macOS/Linux)
#     Copy-Item .env.example .env   (Windows PowerShell)
#
# The real `.env` is git-ignored so local/secret values never get committed.
#
# TWO KINDS OF VARIABLES:
#  - EXPO_PUBLIC_*  → inlined into the app bundle and readable on the device.
#                     Use ONLY for non-sensitive values (public URLs, flags).
#  - everything else → available at build time in app.config.ts (Node), NOT
#                     automatically shipped to the client.

# Which environment this build represents: development | preview | production.
# Read in app.config.ts and surfaced to the app via `extra.appEnv`.
APP_ENV=development

# Base URL of our backend API. Public (safe to ship). Points at your local
# server in dev; the real hosted URL in preview/production.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
